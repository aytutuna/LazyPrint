# Shell scripts run in Git Bash on Windows too, which stops at a carriage return.
*.sh text eol=lf
# Golden files the tests compare byte for byte.
*.bin binary
*.pwg binary
*.urf binary
*.p12 binary
*.pdf binary
*.png binary
*.jpg binary
*.lppkg binary
# The Rust core reads this copy of the IPP fixtures and checks it against SHA256SUMS.
testdata/ipp/** -text
