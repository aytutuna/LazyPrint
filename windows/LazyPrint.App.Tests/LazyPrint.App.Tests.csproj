<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks of the Windows app's own code that need WPF but no window and no printer: the view
       model against stand-in services, the spooler's states as the app maps them. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LazyPrint.App\LazyPrint.App.csproj" />
    <ProjectReference Include="..\LazyPrint.Core\LazyPrint.Core.csproj" />
  </ItemGroup>

  <!-- The loopback printer and the raster reader of the Core tests, which the app's printer is checked against too. -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Compile Include="..\LazyPrint.Core.Tests\LoopbackIppPrinter.cs" Link="Shared\LoopbackIppPrinter.cs" />
    <Compile Include="..\LazyPrint.Core.Tests\IppFixtures.cs" Link="Shared\IppFixtures.cs" />
    <Compile Include="..\LazyPrint.Core.Tests\RasterReader.cs" Link="Shared\RasterReader.cs" />
  </ItemGroup>

  <!-- The fixtures the tests read (Tests/Fixtures at the repository root). -->
  <ItemGroup>
    <None Include="..\..\Tests\Fixtures\**\*" LinkBase="Fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
