<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LazyPrint.Core</RootNamespace>
    <Description>Platform-neutral core of Lazy Print: page layout, booklets and photo sizes,
two-sided printing by hand, the IPP protocol and PWG raster, printer problems and the
troubleshooter's checks, and the phone link's server. No UI and no OS-specific APIs; the one
package dependency, ProtectedData, keeps the phone link's sync keys on Windows and is not called
elsewhere.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LazyPrint.Core.Tests" />
    <InternalsVisibleTo Include="LazyPrint" />
  </ItemGroup>

</Project>
