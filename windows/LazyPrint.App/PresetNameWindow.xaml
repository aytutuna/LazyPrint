<Window x:Class="LazyPrint.App.PresetNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LazyPrint.App"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        FontFamily="{StaticResource TextFontFamily}"
        Icon="{x:Static ui:AppIcon.Image}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooterStyle}" Padding="24,14,24,18">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" IsDefault="True" MinWidth="96" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                <Button Content="Cancel" IsCancel="True" MinWidth="96" Margin="8,0,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Margin="24,20,24,16">
            <TextBlock Text="Name" Style="{StaticResource BodyText}" Margin="0,0,0,6" />
            <TextBox x:Name="NameBox" AutomationProperties.Name="Name" MaxLength="60" />
            <TextBlock x:Name="ProblemText" Style="{StaticResource ReasonText}" Margin="0,8,0,0" Visibility="Collapsed" />
        </StackPanel>
    </DockPanel>
</Window>
