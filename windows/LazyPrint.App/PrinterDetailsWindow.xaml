<Window x:Class="LazyPrint.App.PrinterDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LazyPrint.App"
        Width="460" SizeToContent="Height" MaxHeight="640" ResizeMode="NoResize"
        FontFamily="{StaticResource TextFontFamily}"
        Icon="{x:Static ui:AppIcon.Image}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooterStyle}" Padding="24,14,24,18">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="TestPageButton" Content="Print a test page" MinWidth="96" Click="TestPage_Click" />
                <Button Content="Close" IsDefault="True" IsCancel="True" MinWidth="96" Margin="8,0,0,0"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Body" Margin="24,20,24,16" />
        </ScrollViewer>
    </DockPanel>
</Window>
