<Window x:Class="LazyPrint.App.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LazyPrint.App"
        Title="Password needed"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        FontFamily="{StaticResource TextFontFamily}"
        Icon="{x:Static ui:AppIcon.Image}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooterStyle}" Padding="24,14,24,18">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Open" IsDefault="True" MinWidth="96" Style="{StaticResource AccentButtonStyle}" Click="Open_Click" />
                <Button Content="Cancel" IsCancel="True" MinWidth="96" Margin="8,0,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Margin="24,20,24,16">
            <TextBlock x:Name="MessageText" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="Password" />
        </StackPanel>
    </DockPanel>
</Window>
