<Window x:Class="LazyPrint.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LazyPrint.App"
        Title="Lazy Print"
        Width="1200" Height="800" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="{x:Static local:AppIcon.Image}"
        FontFamily="{StaticResource TextFontFamily}"
        AllowDrop="True" PreviewDragEnter="Window_PreviewDragOver" PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave" PreviewDrop="Window_PreviewDrop">
    <Window.Resources>
        <Style x:Key="SectionExpanderStyle" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="IsExpanded" Value="False" />
            <Setter Property="Margin" Value="{StaticResource SectionSpacing}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="PageActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallIconButtonStyle}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The bars: outside MainContent, so they stay usable whichever tab is open. -->
        <StackPanel Grid.Row="0">
            <!-- Errors, and notices of what cannot be done yet. -->
            <Border x:Name="InfoBar" Style="{StaticResource InfoBarStyle}" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" x:Name="InfoBarGlyph" Style="{StaticResource GlyphText}" Text="&#xEB90;" Margin="0,0,12,0"
                               VerticalAlignment="Top" Padding="0,2,0,0"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE711;"
                            ToolTip="Dismiss" AutomationProperties.Name="Dismiss" VerticalAlignment="Top"
                            Click="InfoBarClose_Click" />
                    <!-- Shown when the error is a printer that would not answer or print. -->
                    <Button DockPanel.Dock="Right" x:Name="InfoBarTroubleshootButton" Style="{StaticResource SubtleButtonStyle}"
                            local:Icon.Glyph="&#xE9CE;" Content="Troubleshoot" VerticalAlignment="Top" Margin="8,0,4,0"
                            Visibility="Collapsed"
                            ToolTip="Find out what's stopping the printer"
                            AutomationProperties.HelpText="Opens the troubleshooter: checks what stops printers from appearing or printing"
                            Click="Troubleshoot_Click" />
                    <TextBlock x:Name="InfoBarText" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive"><Run
                            x:Name="InfoBarTitle" FontWeight="SemiBold" /><Run Text="  " /><Run x:Name="InfoBarMessage" /></TextBlock>
                </DockPanel>
            </Border>

            <!-- A paired phone sent files that wait for the user's say: nothing prints by itself. The next batch
                 shows when this one is added, started as a new job, or dismissed. -->
            <Border x:Name="PhoneBar" Style="{StaticResource SavedBarStyle}" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Text="&#xE8EA;" Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE711;"
                            ToolTip="Dismiss" AutomationProperties.Name="Dismiss these files"
                            VerticalAlignment="Center" Margin="4,0,0,0" Click="PhoneBarDismiss_Click" />
                    <Button DockPanel.Dock="Right" x:Name="PhoneBarNewButton" Style="{StaticResource SubtleButtonStyle}"
                            Content="Start a new job" VerticalAlignment="Center" Margin="8,0,0,0"
                            ToolTip="Clear the job and print these files instead" Click="PhoneBarNew_Click" />
                    <Button DockPanel.Dock="Right" x:Name="PhoneBarAddButton" Style="{StaticResource SubtleButtonStyle}"
                            Content="Add to this job" VerticalAlignment="Center" Margin="8,0,0,0"
                            ToolTip="Put these files in the job with the others" Click="PhoneBarAdd_Click" />
                    <TextBlock x:Name="PhoneBarText" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Padding="0,4"
                               AutomationProperties.LiveSetting="Polite"><Run
                            Text="From your phone" FontWeight="SemiBold" /><Run Text="  " /><Run x:Name="PhoneBarMessage" /></TextBlock>
                </DockPanel>
            </Border>

            <!-- After a job went out: what was sent, with a way to the Jobs tab. -->
            <Border x:Name="SentBar" Style="{StaticResource SavedBarStyle}" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Text="&#xE930;" Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE711;"
                            ToolTip="Dismiss" AutomationProperties.Name="Dismiss" VerticalAlignment="Center"
                            Margin="4,0,0,0" Click="SentBarClose_Click" />
                    <Button DockPanel.Dock="Right" x:Name="SentJobsButton" Style="{StaticResource SubtleButtonStyle}"
                            local:Icon.Glyph="&#xE81C;" Content="Jobs" VerticalAlignment="Center" Margin="8,0,0,0"
                            ToolTip="Show this session's jobs" Click="SentJobs_Click" />
                    <TextBlock x:Name="SentBarText" Style="{StaticResource BodyText}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"><Run x:Name="SentBarMessage" /></TextBlock>
                </DockPanel>
            </Border>
        </StackPanel>

        <DockPanel Grid.Row="1" x:Name="MainContent">
            <!-- Sidebar: the printers, directly on the window backdrop. Below a width threshold it
                 folds to an icon rail (see UpdatePane); names stay in tooltips. -->
            <Grid DockPanel.Dock="Left" x:Name="Sidebar" Width="216">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Button DockPanel.Dock="Left" x:Name="PaneToggleButton" Style="{StaticResource IconButtonStyle}"
                            Content="&#xE700;" Width="40" Height="36" Margin="4,4,0,4" Visibility="Collapsed"
                            ToolTip="Show printer names"
                            AutomationProperties.Name="Show printer names"
                            Click="PaneToggle_Click" />
                    <Button DockPanel.Dock="Right" x:Name="TroubleshootButton" Style="{StaticResource SmallIconButtonStyle}"
                            Content="&#xE9CE;" Margin="0,4,8,0" VerticalAlignment="Center"
                            ToolTip="Why isn't my printer listed?"
                            AutomationProperties.Name="Why isn't my printer listed?"
                            AutomationProperties.HelpText="Opens the troubleshooter: checks what stops printers from appearing"
                            Click="Troubleshoot_Click" />
                    <Button DockPanel.Dock="Right" x:Name="AddPrinterButton" Style="{StaticResource SmallIconButtonStyle}"
                            Content="&#xE710;" Margin="0,4,2,0" VerticalAlignment="Center"
                            ToolTip="Add a network printer"
                            AutomationProperties.Name="Add a network printer by address"
                            Click="AddPrinter_Click" />
                    <TextBlock x:Name="PrintersHeader" Text="Printers" Style="{StaticResource BodyStrongText}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="16,8,16,6"
                               VerticalAlignment="Center" />
                </DockPanel>
                <ListBox Grid.Row="1" x:Name="PrinterList" Style="{StaticResource NavListBoxStyle}" MaxHeight="360"
                         ItemContainerStyle="{StaticResource PrinterListItemStyle}"
                         KeyboardNavigation.TabNavigation="Local"
                         AutomationProperties.Name="Printers" ToolTipService.ShowOnDisabled="True"
                         SelectionChanged="PrinterList_SelectionChanged"
                         ContextMenuOpening="PrinterList_ContextMenuOpening">
                    <!-- One row per printer (PrinterRow): name and state dot, its worst problem, and its
                         ink or toner as thin bars. The folded rail shows the glyph, with the name in its tooltip. -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Style="{StaticResource GlyphText}"
                                           Text="&#xE749;" Margin="0,1,12,0" VerticalAlignment="Top" />
                                <StackPanel x:Name="Texts">
                                    <DockPanel>
                                        <Ellipse x:Name="Dot" DockPanel.Dock="Right" Width="8" Height="8" Margin="8,0,0,0"
                                                 VerticalAlignment="Center" ToolTip="{Binding StateLabel}"
                                                 Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock x:Name="ProblemLine" Text="{Binding Subtitle}" Style="{StaticResource CaptionText}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <ItemsControl x:Name="SupplyBars" ItemsSource="{Binding Supplies}" Focusable="False"
                                                  IsTabStop="False" Margin="0,4,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="3" Margin="0,0,3,0" ToolTip="{Binding Description}">
                                                    <Border CornerRadius="1.5" Background="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                                                    <Border CornerRadius="1.5" Background="{Binding Fill}" RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding Fraction}" />
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Info.State}" Value="Idle">
                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Info.State}" Value="Printing">
                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Info.State}" Value="Stopped">
                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Info.State}" Value="Offline">
                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Subtitle}" Value="">
                                    <Setter TargetName="ProblemLine" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Supplies.Count}" Value="0">
                                    <Setter TargetName="SupplyBars" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPaneCompact, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Value="True">
                                    <Setter TargetName="Texts" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Glyph" Property="Margin" Value="0" />
                                    <!-- The icon rail shows no name: the printer's name is its tooltip there. -->
                                    <Setter TargetName="Glyph" Property="ToolTip" Value="{Binding Description}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- The empty state while no printer but the demo printer is listed (shown from code:
                     UpdateEmptyPrintersHint); the + in the header adds one by address. -->
                <TextBlock Grid.Row="2" x:Name="EmptyPrintersHint" Margin="16,4" TextWrapping="Wrap"
                           Style="{StaticResource CaptionText}" Visibility="Collapsed"><Run
                        Text="No other printer found" /><LineBreak /><Hyperlink
                        x:Name="EmptyTroubleshootLink" Click="Troubleshoot_Click"
                        AutomationProperties.Name="Troubleshoot: why isn't my printer listed?">Troubleshoot</Hyperlink>
                </TextBlock>

                <StackPanel Grid.Row="4">
                    <!-- Pair a phone, the paired phones and the networks receiving is allowed on. -->
                    <Button x:Name="PhoneButton" Style="{StaticResource SubtleButtonStyle}"
                            local:Icon.Glyph="&#xE8EA;" Content="Phone"
                            ToolTip="Print files from your phone"
                            AutomationProperties.HelpText="Opens the phone settings: pair a phone, the paired phones and the networks this PC receives on"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="4,4,4,0"
                            Click="PhoneButton_Click" />
                    <Button x:Name="AppearanceButton" Style="{StaticResource SubtleButtonStyle}"
                            local:Icon.Glyph="&#xE793;" Content="Appearance"
                            ToolTip="Light, dark, or follow Windows"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="4,4,4,8"
                            Click="AppearanceButton_Click" />
                </StackPanel>
            </Grid>

            <TabControl x:Name="MainTabs" Style="{StaticResource PivotTabControlStyle}"
                        SelectionChanged="MainTabs_SelectionChanged">
                <!-- Print: the sheet preview and the documents, with the inspector on the right. -->
                <TabItem Header="Print" x:Name="PrintTab" local:Icon.Glyph="&#xE749;">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- The Task menu is always there; the active task and the way to leave it
                                 (keeping its settings) show while one is set. -->
                            <Border Grid.Row="0" x:Name="TaskBanner" Style="{StaticResource TaskBannerStyle}"
                                    Margin="12,12,12,0">
                                <GroupBox x:Name="TaskBannerGroup" Style="{StaticResource TaskBannerGroupStyle}"
                                          AutomationProperties.LiveSetting="Polite">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Left" x:Name="TaskButton" Style="{StaticResource SubtleButtonStyle}"
                                                local:Icon.Glyph="&#xE8FD;" Content="Task" VerticalAlignment="Center"
                                                ToolTip="Pick what you are printing"
                                                Click="TaskButton_Click" />
                                        <Button DockPanel.Dock="Right" x:Name="ExitTaskButton" Style="{StaticResource SmallIconButtonStyle}"
                                                Content="&#xE711;" VerticalAlignment="Center" Margin="2,0,0,0"
                                                ToolTip="Leave the task (settings stay)"
                                                AutomationProperties.Name="Leave the task"
                                                Click="ExitTask_Click" />
                                        <TextBlock DockPanel.Dock="Left" x:Name="TaskBannerGlyph" Style="{StaticResource GlyphText}"
                                                   FontSize="20" VerticalAlignment="Center" Margin="12,0,0,0"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <StackPanel x:Name="TaskBannerText" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock x:Name="TaskBannerTitle" Style="{StaticResource BodyStrongText}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="TaskBannerPrompt" Style="{StaticResource SecondaryBodyText}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </GroupBox>
                            </Border>

                            <!-- Stage: the sheet sits on a neutral surface with a soft shadow. -->
                            <Border Grid.Row="1" x:Name="Stage" Style="{StaticResource StageStyle}" Margin="12">
                                <Grid x:Name="StageHost" SizeChanged="StageHost_SizeChanged">
                                    <!-- The margin must stay uniform: StageHost_SizeChanged reads it for every side. -->
                                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="24" Visibility="Collapsed"
                                           Effect="{DynamicResource PageShadow}"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel x:Name="EmptyStage" Style="{StaticResource EmptyStatePanelStyle}">
                                        <Border Style="{StaticResource EmptyStateCircleStyle}">
                                            <TextBlock Text="&#xE8A5;" Style="{StaticResource EmptyStateGlyphStyle}" />
                                        </Border>
                                        <TextBlock Text="{x:Static local:ShortText.NoDocuments}" Style="{StaticResource EmptyStateTitleStyle}" />
                                        <TextBlock Text="{x:Static local:ShortText.AddFiles}" Style="{StaticResource EmptyStateBodyStyle}" />
                                        <Button x:Name="EmptyAddFilesButton" Style="{StaticResource SubtleButtonStyle}"
                                                local:Icon.Glyph="&#xE710;" Content="Add files…" HorizontalAlignment="Center"
                                                Margin="0,16,0,0" ToolTip="Add PDFs and pictures" Click="AddFiles_Click" />
                                        <TextBlock Text="{x:Static local:ShortText.DropHint}" Style="{StaticResource CaptionText}"
                                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Which sheet, and which side of it. -->
                            <DockPanel Grid.Row="2" x:Name="PreviewBar" Margin="12,0,12,0" Visibility="Collapsed">
                                <Border DockPanel.Dock="Right" x:Name="FaceTrack" Style="{StaticResource SegmentedTrackStyle}"
                                        AutomationProperties.Name="Side shown">
                                    <UniformGrid Columns="2">
                                        <RadioButton x:Name="FaceFront" Style="{StaticResource SegmentedTextItemStyle}" Content="Front"
                                                     ToolTip="The front of the sheet" Checked="Face_Changed" />
                                        <RadioButton x:Name="FaceBack" Style="{StaticResource SegmentedTextItemStyle}" Content="Back"
                                                     ToolTip="The back, as it looks with the sheet turned over" Checked="Face_Changed" />
                                    </UniformGrid>
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="PreviousSheetButton" Style="{StaticResource IconButtonStyle}" Content="&#xE76B;"
                                            ToolTip="Previous sheet" AutomationProperties.Name="Previous sheet"
                                            Click="PreviousSheet_Click" />
                                    <TextBlock x:Name="SheetLabel" Style="{StaticResource BodyText}" MinWidth="110"
                                               TextAlignment="Center" VerticalAlignment="Center"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <Button x:Name="NextSheetButton" Style="{StaticResource IconButtonStyle}" Content="&#xE76C;"
                                            ToolTip="Next sheet" AutomationProperties.Name="Next sheet"
                                            Click="NextSheet_Click" />
                                </StackPanel>
                            </DockPanel>

                            <!-- What the layout did to the pages: blanks added, pages made smaller, edges cut off. -->
                            <ItemsControl Grid.Row="3" x:Name="PlanNotes" Margin="12,6,12,0" Focusable="False" IsTabStop="False"
                                          AutomationProperties.LiveSetting="Polite" Visibility="Collapsed">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,2">
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE946;" />
                                            <TextBlock Text="{Binding}" Style="{StaticResource ReasonText}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- The documents: their order is the order of the pages. -->
                            <Border Grid.Row="4" x:Name="DocumentStrip" Background="Transparent" Padding="12,8,12,8"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <DockPanel Margin="2,0,0,6">
                                        <Button DockPanel.Dock="Right" x:Name="AddFilesButton" Style="{StaticResource SubtleButtonStyle}"
                                                local:Icon.Glyph="&#xE710;" Content="Add files…" ToolTip="Add PDFs and pictures"
                                                Click="AddFiles_Click" />
                                        <TextBlock x:Name="DocumentStripLabel" Style="{StaticResource CaptionText}" TextWrapping="NoWrap"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <!-- Tab walks through every document's buttons (a ListBox would otherwise take one tab
                                         stop and skip them). -->
                                    <ListBox x:Name="DocumentList" Height="150"
                                             AutomationProperties.Name="Documents"
                                             KeyboardNavigation.TabNavigation="Continue"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             BorderThickness="0" Background="Transparent" Padding="0,0,0,16"
                                             ItemContainerStyle="{StaticResource ThumbnailListItemStyle}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Width="124" Height="132">
                                                    <Border x:Name="Card" Style="{StaticResource CardStyle}" Padding="6"
                                                            ToolTip="{Binding Name}" AutomationProperties.Name="{Binding AutomationName}">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding PagesText}"
                                                                       Style="{StaticResource CaptionText}" TextWrapping="NoWrap" />
                                                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}"
                                                                       Style="{StaticResource BodyText}" TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </DockPanel>
                                                    </Border>
                                                    <Border x:Name="Actions" Style="{StaticResource HoverActionBarStyle}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Style="{StaticResource PageActionButtonStyle}" Content="&#xE76B;"
                                                                    ToolTip="Move earlier" AutomationProperties.Name="Move earlier"
                                                                    IsEnabled="{Binding CanMoveEarlier}" Click="DocumentEarlier_Click" />
                                                            <Button Style="{StaticResource PageActionButtonStyle}" Content="&#xE74D;"
                                                                    ToolTip="Remove" AutomationProperties.Name="Remove"
                                                                    Click="DocumentRemove_Click" />
                                                            <Button Style="{StaticResource PageActionButtonStyle}" Content="&#xE76C;"
                                                                    ToolTip="Move later" AutomationProperties.Name="Move later"
                                                                    IsEnabled="{Binding CanMoveLater}" Click="DocumentLater_Click" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- The inspector: the settings in sections (InspectorSections), with Print pinned at
                             its foot. A control that cannot apply is hidden; one that conflicts with another
                             choice is greyed out with its reason beside it. -->
                        <Grid Grid.Column="1" Width="280">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="2" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" />
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="12" x:Name="Inspector">

                                    <Expander x:Name="PrinterSection" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Printer" Style="{StaticResource FieldLabelText}" />
                                            <ComboBox x:Name="PrinterBox" HorizontalAlignment="Stretch" DisplayMemberPath="Name"
                                                      AutomationProperties.Name="Printer"
                                                      SelectionChanged="PrinterBox_SelectionChanged" />
                                            <DockPanel x:Name="PrinterProblemRow" Margin="0,6,0,0" Visibility="Collapsed">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE7BA;"
                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                <TextBlock x:Name="PrinterProblemText" Style="{StaticResource ReasonText}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="PagesSection" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Copies" Style="{StaticResource FieldLabelText}" />
                                            <ComboBox x:Name="CopiesBox" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="Number of copies"
                                                      SelectionChanged="Setting_Changed" />
                                            <CheckBox x:Name="CollateBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,8,0,0"
                                                      Content="Collate"
                                                      ToolTip="Prints each copy in page order"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />

                                            <TextBlock Text="Pages" Style="{StaticResource FieldLabelText}" Margin="0,12,0,4" />
                                            <Grid>
                                                <TextBox x:Name="PageRangeBox" AutomationProperties.Name="Pages to print"
                                                         AutomationProperties.HelpText="Page numbers and ranges, for example 1-3, 5. Empty prints every page."
                                                         TextChanged="PageRangeBox_TextChanged" />
                                                <TextBlock x:Name="PageRangePlaceholder" Style="{StaticResource PlaceholderText}"
                                                           Text="All, or 1-3, 5" />
                                            </Grid>
                                            <DockPanel x:Name="PageRangeProblemRow" Margin="0,6,0,0" Visibility="Collapsed">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE7BA;"
                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                <TextBlock x:Name="PageRangeProblemText" Style="{StaticResource ReasonText}"
                                                           AutomationProperties.LiveSetting="Polite" />
                                            </DockPanel>

                                            <StackPanel x:Name="SidesGroup">
                                                <TextBlock Text="Two-sided" Style="{StaticResource FieldLabelText}" Margin="0,12,0,4" />
                                                <Border x:Name="SidesTrack" Style="{StaticResource SegmentedTrackStyle}"
                                                        AutomationProperties.Name="Two-sided" ToolTipService.ShowOnDisabled="True">
                                                    <UniformGrid Columns="3">
                                                        <RadioButton x:Name="SidesOne" Style="{StaticResource SegmentedTextItemStyle}" Content="Off"
                                                                     ToolTip="One side of the paper" Checked="Setting_Changed" />
                                                        <RadioButton x:Name="SidesLong" Style="{StaticResource SegmentedTextItemStyle}" Content="Long edge"
                                                                     ToolTip="Turn the sheet over on its long edge, like a book" Checked="Setting_Changed" />
                                                        <RadioButton x:Name="SidesShort" Style="{StaticResource SegmentedTextItemStyle}" Content="Short edge"
                                                                     ToolTip="Turn the sheet over on its short edge, like a notepad" Checked="Setting_Changed" />
                                                    </UniformGrid>
                                                </Border>
                                                <DockPanel x:Name="SidesReasonRow" Margin="0,6,0,0" Visibility="Collapsed">
                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE946;" />
                                                    <TextBlock x:Name="SidesReasonText" Style="{StaticResource ReasonText}" />
                                                </DockPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="LayoutSection" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Pages per side" Style="{StaticResource FieldLabelText}" />
                                            <ComboBox x:Name="PerSideBox" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="Pages per side"
                                                      ToolTipService.ShowOnDisabled="True"
                                                      SelectionChanged="Setting_Changed" />
                                            <DockPanel x:Name="PerSideReasonRow" Margin="0,6,0,0" Visibility="Collapsed">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE946;" />
                                                <TextBlock x:Name="PerSideReasonText" Style="{StaticResource ReasonText}" />
                                            </DockPanel>
                                            <CheckBox x:Name="BookletBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,12,0,0"
                                                      Content="Booklet"
                                                      ToolTip="Two pages on each side, in the order that folds into a booklet"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                            <CheckBox x:Name="RightToLeftBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,4,0,0"
                                                      Content="Right to left"
                                                      ToolTip="Pages read from right to left"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                            <CheckBox x:Name="BordersBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,4,0,0"
                                                      Content="Page borders"
                                                      ToolTip="A thin line around each page"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                            <TextBlock Text="Scaling" Style="{StaticResource FieldLabelText}" Margin="0,12,0,4" />
                                            <ComboBox x:Name="ScalingBox" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="Scaling"
                                                      SelectionChanged="Setting_Changed" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="PaperSection" Style="{StaticResource SectionExpanderStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Paper" Style="{StaticResource FieldLabelText}" />
                                            <ComboBox x:Name="PaperBox" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="Paper"
                                                      SelectionChanged="Setting_Changed" />
                                            <DockPanel x:Name="PaperNoteRow" Margin="0,6,0,0" Visibility="Collapsed">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE7BA;"
                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                <TextBlock x:Name="PaperNoteText" Style="{StaticResource ReasonText}" />
                                            </DockPanel>
                                            <TextBlock Text="Quality" Style="{StaticResource FieldLabelText}" Margin="0,12,0,4" />
                                            <ComboBox x:Name="QualityBox" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="Quality"
                                                      ToolTipService.ShowOnDisabled="True"
                                                      SelectionChanged="Setting_Changed" />
                                            <DockPanel x:Name="QualityReasonRow" Margin="0,6,0,0" Visibility="Collapsed">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE946;" />
                                                <TextBlock x:Name="QualityReasonText" Style="{StaticResource ReasonText}" />
                                            </DockPanel>
                                            <TextBlock Text="Color" Style="{StaticResource FieldLabelText}" Margin="0,12,0,4" />
                                            <Border x:Name="ColorTrack" Style="{StaticResource SegmentedTrackStyle}"
                                                    AutomationProperties.Name="Color" ToolTipService.ShowOnDisabled="True">
                                                <UniformGrid Columns="2">
                                                    <RadioButton x:Name="ColorColor" Style="{StaticResource SegmentedTextItemStyle}" Content="Color"
                                                                 Checked="Setting_Changed" />
                                                    <RadioButton x:Name="ColorGray" Style="{StaticResource SegmentedTextItemStyle}" Content="Gray"
                                                                 Checked="Setting_Changed" />
                                                </UniformGrid>
                                            </Border>
                                            <DockPanel x:Name="ColorReasonRow" Margin="0,6,0,0" Visibility="Collapsed">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE946;" />
                                                <TextBlock x:Name="ColorReasonText" Style="{StaticResource ReasonText}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="PhotosSection" Style="{StaticResource SectionExpanderStyle}" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="Size" Style="{StaticResource FieldLabelText}" />
                                            <ComboBox x:Name="PhotoSizeBox" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="Photo size"
                                                      ToolTipService.ShowOnDisabled="True"
                                                      SelectionChanged="Setting_Changed" />
                                            <DockPanel x:Name="PhotoSizeReasonRow" Margin="0,6,0,0" Visibility="Collapsed">
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE946;" />
                                                <TextBlock x:Name="PhotoSizeReasonText" Style="{StaticResource ReasonText}" />
                                            </DockPanel>
                                            <CheckBox x:Name="PhotoFillBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,12,0,0"
                                                      Content="Fill the size"
                                                      ToolTip="Off: the whole photo fits, with white bands"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                            <CheckBox x:Name="CutMarksBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,4,0,0"
                                                      Content="Cut marks"
                                                      ToolTip="Short marks at the corners when several prints fit on a sheet"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Pinned at the foot: Print says what it does. -->
                            <Border Grid.Row="1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" Padding="12">
                                <Button x:Name="PrintButton" Style="{StaticResource AccentIconTextButtonStyle}"
                                        local:Icon.Glyph="&#xE749;" Content="Print" MinHeight="36"
                                        ToolTipService.ShowOnDisabled="True" Click="Print_Click" />
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Jobs: this session's, newest first. -->
                <TabItem Header="Jobs" x:Name="JobsTab" local:Icon.Glyph="&#xE81C;">
                    <Grid>
                        <StackPanel x:Name="EmptyJobs" Style="{StaticResource EmptyStatePanelStyle}">
                            <Border Style="{StaticResource EmptyStateCircleStyle}">
                                <TextBlock Text="&#xE81C;" Style="{StaticResource EmptyStateGlyphStyle}" />
                            </Border>
                            <TextBlock Text="No jobs yet" Style="{StaticResource EmptyStateTitleStyle}" />
                            <TextBlock Text="What you print in this session appears here." Style="{StaticResource EmptyStateBodyStyle}" />
                        </StackPanel>
                        <ListBox x:Name="JobList" Style="{StaticResource NavListBoxStyle}" Margin="12"
                                 AutomationProperties.Name="Jobs" KeyboardNavigation.TabNavigation="Local">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavListBoxItemStyle}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Description}" />
                                    <Setter Property="Focusable" Value="False" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <!-- One row per job (JobRow): its state, and what can be done with it. -->
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StateText}" Style="{StaticResource CaptionText}"
                                                       VerticalAlignment="Center" Margin="12,0,8,0" />
                                            <Button x:Name="CancelJobButton" Style="{StaticResource SubtleButtonStyle}"
                                                    local:Icon.Glyph="&#xE711;" Content="Cancel"
                                                    ToolTip="Stop this job" Click="JobCancel_Click" />
                                            <Button x:Name="PrintAgainButton" Style="{StaticResource SubtleButtonStyle}"
                                                    local:Icon.Glyph="&#xE72C;" Content="Print again"
                                                    ToolTip="Print this job once more" Click="JobAgain_Click" />
                                            <Button x:Name="ShowFolderButton" Style="{StaticResource SubtleButtonStyle}"
                                                    local:Icon.Glyph="&#xE838;" Content="Show folder"
                                                    ToolTip="Show the pictures the Demo printer made" Click="JobFolder_Click" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                            <Setter TargetName="CancelJobButton" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFinished}" Value="False">
                                            <Setter TargetName="PrintAgainButton" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasFolder}" Value="False">
                                            <Setter TargetName="ShowFolderButton" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- Two-sided by hand: the fronts are printed; the stack goes back, and the backs follow. Modal like Lazy Scan's
             review dialogs, leaving the status bar (with its Cancel button) reachable. -->
        <Grid Grid.Row="1" x:Name="DuplexOverlay" Background="{DynamicResource SmokeFillColorDefaultBrush}"
              Visibility="Collapsed" PreviewKeyDown="DuplexOverlay_PreviewKeyDown"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
            <Border Style="{StaticResource DialogCardStyle}" MaxWidth="520" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="360">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Padding="24,16">
                        <WrapPanel x:Name="DuplexButtons" HorizontalAlignment="Right" />
                    </Border>
                    <Border Background="{DynamicResource LayerFillColorAltBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0" Padding="24,20,24,20">
                        <StackPanel>
                            <TextBlock x:Name="DuplexTitle" Style="{StaticResource SubtitleText}" Margin="0,0,0,12"
                                       AutomationProperties.HeadingLevel="Level1" />
                            <!-- The reload picture: the stack with its top edge, turned over or as it lies. -->
                            <Border Style="{StaticResource ImageWellStyle}" Height="96" Margin="0,0,0,12">
                                <TextBlock x:Name="DuplexPicture" Style="{StaticResource GlyphText}" FontSize="48"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5" />
                            </Border>
                            <TextBlock x:Name="DuplexText" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- While files the window takes are dragged over it: where they go. -->
        <Border Grid.Row="1" x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" Margin="8"
                CornerRadius="8" BorderThickness="2"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                Background="{DynamicResource SmokeFillColorDefaultBrush}">
            <Border Style="{StaticResource DialogCardStyle}" Padding="24,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource GlyphText}" FontSize="24" Text="&#xEB9F;" Margin="0,0,12,0"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="{x:Static local:ShortText.DropFiles}" Style="{StaticResource SubtitleText}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Status bar -->
        <StatusBar Grid.Row="2" Background="Transparent" BorderThickness="0,1,0,0"
                   BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" MinHeight="36" Padding="8,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar x:Name="BusyBar" Width="160" VerticalAlignment="Center" Margin="0,0,12,0"
                                 IsIndeterminate="True" AutomationProperties.Name="Progress" Visibility="Collapsed" />
                    <Button x:Name="CancelButton" Style="{StaticResource IconTextButtonStyle}"
                            local:Icon.Glyph="&#xE711;" Content="Cancel" Padding="10,3,10,4"
                            Visibility="Collapsed" Click="Cancel_Click" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <!-- A short line on screen; its name is the whole sentence, read out as it changes. -->
                <TextBlock x:Name="StatusText" Text="Looking for printers…" Style="{StaticResource CaptionText}"
                           FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
